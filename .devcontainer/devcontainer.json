{
  "name": "Jekyll Dev Container",
  "image": "mcr.microsoft.com/devcontainers/jekyll:2-bookworm",

  // Forward both the Jekyll server and the LiveReload WebSocket port
  "forwardPorts": [4000, 35729],

  // Port attributes to automatically open port 4000 in browser
  "portsAttributes": {
    "4000": {
      "label": "Jekyll Web Server",
      "onAutoForward": "openPreview"
    },
    "35729": {
      "label": "LiveReload Server",
      "onAutoForward": "silent"
    }
  },

  // Install dependencies and Git LFS during container creation
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y git-lfs && git lfs install && cd docs && bundle install",

  // Start the Jekyll site automatically whenever the container starts
  "postStartCommand": "cd docs && bundle exec jekyll serve --host 0.0.0.0 --livereload",

  // Useful VS Code extensions for Jekyll/Markdown editing
  "customizations": {
    "vscode": {
      "extensions": [
        "shopify.ruby-lsp",
        "DavidAnson.vscode-markdownlint"
      ]
    }
  },

  "remoteUser": "vscode"
}